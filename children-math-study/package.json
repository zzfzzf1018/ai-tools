{
  "name": "math-wonder-island",
  "version": "1.0.0",
  "private": true,
  "description": "数学奇妙岛 · 儿童小学数学思维学习工具（一至五年级·上海教材）",
  "main": "desktop/main.js",
  "author": "zzf",
  "license": "MIT",
  "scripts": {
    "desktop": "electron .",
    "desktop:runtime": "node node_modules/electron/install.js",
    "package": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.zzf.mathwonder",
    "productName": "Math Wonder Island",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "content/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "desktop/icon.ico"
    },
    "portable": {
      "artifactName": "Math-Wonder-Island-${version}-${arch}-portable.${ext}"
    }
  }
}
