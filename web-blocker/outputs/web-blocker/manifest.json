{
  "manifest_version": 3,
  "name": "网页屏蔽器",
  "version": "1.4.4",
  "description": "点选网页任意区域并记住规则，之后每次打开都自动屏蔽它。点选即锁定，支持同类批量、收回留白补位、整站或单页生效、快捷键暂停、导入导出。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-tab": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "MacCtrl+Shift+B"
      },
      "description": "临时暂停 / 恢复当前页面的屏蔽（刷新页面后自动恢复屏蔽）"
    },
    "toggle-site": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "MacCtrl+Shift+S"
      },
      "description": "暂停 / 恢复整个站点的屏蔽（会记住）"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup.html",
    "default_title": "网页屏蔽器（Alt+Shift+B 暂停本页）"
  }
}
