{
  "name": "kids-english-wonderland",
  "version": "1.0.6",
  "private": true,
  "description": "趣味英语乐园 · 儿童小学英语学习工具（一至五年级）",
  "main": "desktop/main.js",
  "author": "zzf",
  "license": "MIT",
  "scripts": {
    "desktop": "electron .",
    "desktop:runtime": "node node_modules/electron/install.js",
    "package": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.zzf.kidsenglish",
    "productName": "Kids English Wonderland",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "desktop/icon.ico"
    },
    "portable": {
      "artifactName": "Kids-English-Wonderland-${version}-${arch}-portable.${ext}"
    }
  }
}
