{
  "name": "word-memory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WordMemory · 8000 核心词汇间隔重复记忆工具（Web 版 + 单文件离线版）",
  "keywords": [
    "vocabulary",
    "spaced-repetition",
    "srs",
    "english-learning"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "verify": "npm run test && npm run build && node scripts/verify.mjs",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.65.0"
  }
}
