{
  "name": "sunny-isles-sel",
  "productName": "心晴岛",
  "version": "1.0.6",
  "private": true,
  "description": "心晴岛：面向儿童的社会情绪学习桌面应用（静态网页的 Electron 外壳）",
  "author": "心晴岛",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node desktop/serve.mjs",
    "build": "npm run build:win",
    "build:win": "electron-builder --win --x64",
    "build:portable": "electron-builder --win --x64",
    "verify": "node tools/verify.mjs",
    "smoke": "node tools/smoke.mjs",
    "release:plan": "node scripts/release.cjs plan",
    "release:version": "node scripts/release.cjs version",
    "release:prepare": "node scripts/release.cjs prepare"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "jsdom": "^30.1.3",
    "semver": "^7.6.3"
  },
  "build": {
    "appId": "com.sunnyisles.sel",
    "asar": true,
    "files": [
      "index.html",
      "src/**/*",
      "desktop/**/*",
      "!desktop/serve.mjs",
      "package.json",
      "!**/*.md",
      "!**/*.bat",
      "!dist/**"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "SunnyIsles-SEL-${version}.${ext}"
    },
    "directories": {
      "output": "dist"
    }
  }
}
